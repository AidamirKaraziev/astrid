# App
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# plain — цветной вывод (dev); json — structured stdout (prod / Loki)
LOG_FORMAT=plain
# OpenTelemetry traces (этап 3 observability)
OTEL_ENABLED=false
OTEL_TRACES_SAMPLE_RATE=0.1
# true — весь Bot API через TELEGRAM_PROXY_URL; false — прямое подключение
USE_VPN=false

# Database
DATABASE_URL=postgresql+asyncpg://astra:astra@localhost:5432/astra
# Порт Postgres на хосте (docker compose). Локально 5432; на deadtiger для pgAdmin снаружи — 15432
POSTGRES_HOST_PORT=5432

# GeoNames: автозагрузка справочника городов при старте, если places пуста
GEONAMES_AUTO_IMPORT=true

# Redis
REDIS_URL=redis://localhost:6379/0
# FSM бота: redis (нужен docker redis) или memory (без Redis)
FSM_STORAGE=redis

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=YourAstraBot
# Личный аккаунт Astrid для кнопки «✉️ Помощь» (без @)
TELEGRAM_SUPPORT_USERNAME=
TELEGRAM_MODE=polling
# Proxy только для Bot API (SOCKS5 или HTTP). НЕ tg://proxy (это MTProto для приложения Telegram)
# TELEGRAM_PROXY_URL=socks5://user:pass@proxy.example.com:1080
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/v1/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=random-secret-string

# Points
POINTS_DAILY_VISIT=7
REFERRAL_BONUS_REFERRER=50
REFERRAL_BONUS_INVITEE=10

# Notifications
NOTIFICATION_HOUR=9
NOTIFICATION_MINUTE=0

# RabbitMQ (обязателен: натал, предсказания, совместимость, рассылка)
RABBITMQ_URL=amqp://astra:astra@localhost:5672/
RABBITMQ_PREFETCH=8

# Ollama — self-hosted LLM, бесплатные ежедневные предсказания (deadtiger: gemma4:e2b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SECONDS=300

# xAI Grok — зарезервировано, пока не используется
GROK_ENABLED=false
XAI_API_KEY=
GROK_MODEL=grok-4-1-fast-non-reasoning
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=120

# Google Gemini (AI Studio) — A/B «Совместимость», платные продукты
# Ключ: https://aistudio.google.com/apikey
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=120

# OpenRouter — A/B «Совместимость», платные продукты
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Рекомендуемая free-модель для Astrid RU: instruct, 262K ctx
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,mistralai/mistral-small-3.1-24b-instruct:free
OPENROUTER_TIMEOUT_SECONDS=120

# OpenAI — «Совместимость», GPT-5.5
# Ключ: https://platform.openai.com/api-keys
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=180

# DeepSeek — «Совместимость», V4-Flash (non-thinking)
# Ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT_SECONDS=120

# PDF совместимости (локально: data/compatibility_pdfs, Docker: /data/compatibility)
COMPATIBILITY_PDF_DIR=data/compatibility_pdfs

# Sentry (опционально; в UI: Environment + тег service)
SENTRY_ENABLED=true
SENTRY_DSN=
# Стенд: local | dev | prod (в Sentry → Issues → filter Environment)
SENTRY_ENVIRONMENT=local
# Компонент: api | worker (в docker-compose для worker задаётся worker)
SENTRY_SERVICE=api
# Заголовки запросов и IP пользователей (см. docs.sentry.io data-collected)
SENTRY_SEND_DEFAULT_PII=false
# Доля транзакций для performance monitoring (0.0 — выкл, 1.0 — все)
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Версия релиза в Sentry (по умолчанию astra@<version из pyproject>)
# SENTRY_RELEASE=astra@0.1.0
